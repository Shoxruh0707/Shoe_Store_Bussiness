PORT=3000
FRONTEND_URL=http://localhost:3001
SESSION_SECRET=replace_with_a_long_random_value

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=shoes_store_app
DB_PASSWORD=your_password_here
DB_NAME=shoes_store_db

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=https://your-public-domain.example/inventory
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# Keep true in production. Set to false only for local frontend development without Telegram auth.
API_AUTH_REQUIRED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Optional: default store used when creating inventory rows from the product form.
DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Default Store
DEFAULT_OWNER_PHONE=+998000000001

# Optional: products.brand_id is required by the DDL, but the current form does not ask for brand.
DEFAULT_BRAND_NAME=Unbranded

# Optional local Python/rembg service. Docker Compose sets these automatically.
BACKGROUND_REMOVAL_URL=http://127.0.0.1:7000
BACKGROUND_REMOVAL_REQUIRED=false
BACKGROUND_REMOVAL_TIMEOUT_MS=120000
