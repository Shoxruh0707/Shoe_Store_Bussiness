NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=replace_with_a_long_random_value
OTP_SECRET=replace_with_a_different_long_random_value
SESSION_COOKIE_SECURE=false
API_AUTH_REQUIRED=true
APP_TIMEZONE=Asia/Tashkent
CORS_ORIGINS=

# Verification email. Keep disabled until a real sender domain and SMTP account are configured.
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=noreply
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Swagger page access (separate from application login). Set credentials before enabling.
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=shoes_store_db

DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Default Store
DEFAULT_OWNER_PHONE=+998000000001
DEFAULT_OWNER_PASSWORD_HASH=
DEFAULT_BRAND_NAME=Unbranded

# Migration CLI credentials are deliberately separate from runtime credentials.
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=3306
MIGRATION_DB_USER=root
MIGRATION_DB_PASSWORD=your_password_here
MIGRATION_DB_NAME=shoes_store_db
