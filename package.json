{
  "name": "admin-shoe-store",
  "version": "1.0.0",
  "description": "Seller inventory web app for managing shoe products and stock.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "bot": "node src/telegramBot.js",
    "channel-bot": "node src/telegramChannelBot.js",
    "stack:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-stack.ps1",
    "stack:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-stack.ps1 -Restart",
    "phone:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-phone-test.ps1",
    "phone:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-phone-test.ps1",
    "test": "node --test test/unit/app-lifecycle.test.js test/unit/config.test.js test/unit/http-errors.test.js test/unit/legacy-session.test.js test/unit/migration-runner.test.js test/unit/password-auth.test.js test/unit/test-database-config.test.js",
    "test:integration": "node --test test/integration/contracts.test.js test/integration/inventory.test.js test/integration/migration-runner.test.js test/integration/schema-upgrade.test.js test/integration/store-authorization.test.js",
    "db:status": "node scripts/migrate.js status",
    "db:migrate": "node scripts/migrate.js apply"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0"
  }
}
