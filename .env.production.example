# Public DNS name pointed to the DigitalOcean Droplet. Do not include https://.
DOMAIN=inventory.example.com
ACME_EMAIL=admin@example.com

# Optional. Use when Caddy should serve multiple hostnames.
# CADDY_DOMAINS=inventory.example.com,www.inventory.example.com

# Optional explicit public URLs. Leave these commented to derive them from DOMAIN.
# PUBLIC_URL=https://inventory.example.com
# FRONTEND_URL=https://inventory.example.com
# TELEGRAM_WEBAPP_URL=https://inventory.example.com/inventory
# CORS_ORIGINS=https://inventory.example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Keep DB_NAME as shoes_store_db unless you also edit shoes_store_database_ddl.sql.
DB_HOST=mysql
DB_PORT=3306
DB_USER=shoes_store_app
DB_PASSWORD=replace_with_a_long_random_database_password
DB_NAME=shoes_store_db
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password

SESSION_SECRET=replace_with_at_least_32_random_bytes
API_AUTH_REQUIRED=true
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token
TELEGRAM_BOT_USERNAME=replace_with_your_bot_username
TELEGRAM_CHANNEL_BOT_TOKEN=replace_with_your_channel_botfather_token
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_CHANNEL_POLL_TIMEOUT_SECONDS=25
# Optional. Use if Telegram needs public URLs for product images instead of direct file upload.
TELEGRAM_PUBLIC_ASSET_BASE_URL=https://inventory.example.com

DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Default Store
DEFAULT_OWNER_PHONE=+998000000001
DEFAULT_OWNER_PASSWORD_HASH=
DEFAULT_BRAND_NAME=Unbranded
