# Public DNS name pointed to the server. Change this value to deploy under any
# domain you own. Do not include https:// or a trailing slash.
DOMAIN=inventory.example.com
# Optional: include extra hostnames for Caddy certificates.
# Example for apex + www: CADDY_DOMAINS=ombor.me, www.ombor.me
CADDY_DOMAINS=
ACME_EMAIL=admin@example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Keep DB_NAME as shoes_store_db unless you also edit shoes_store_database_ddl.sql.
DB_HOST=mysql
DB_PORT=3306
DB_USER=shoes_store_app
DB_PASSWORD=replace_with_a_long_random_database_password
DB_NAME=shoes_store_db
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password

SESSION_SECRET=replace_with_at_least_32_random_bytes
API_AUTH_REQUIRED=true
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Optional overrides. Leave blank to derive https://DOMAIN automatically.
PUBLIC_URL=
CORS_ORIGINS=

TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token
TELEGRAM_BOT_USERNAME=replace_with_your_bot_username
TELEGRAM_POLL_TIMEOUT_SECONDS=25

DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Default Store
DEFAULT_OWNER_PHONE=+998000000001
DEFAULT_BRAND_NAME=Unbranded
