DOMAIN=inventory.example.com
PUBLIC_URL=https://inventory.example.com
ACME_EMAIL=admin@example.com
CADDY_DOMAINS=inventory.example.com
CORS_ORIGINS=

# Swagger page access (separate from application login). Set credentials before enabling.
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_USER=shoes_store_app
DB_PASSWORD=replace_with_a_long_random_database_password
DB_NAME=shoes_store_db
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password

SESSION_SECRET=replace_with_at_least_32_random_bytes
API_AUTH_REQUIRED=true
SESSION_COOKIE_SECURE=true

DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Default Store
DEFAULT_OWNER_PHONE=+998000000001
DEFAULT_OWNER_PASSWORD_HASH=
DEFAULT_BRAND_NAME=Unbranded
# Optional dedicated migration account. Compose uses root when omitted.
# MIGRATION_DB_USER=shoes_store_migrator
# MIGRATION_DB_PASSWORD=replace_with_a_migration_password
