# Public DNS name pointed to the DigitalOcean Droplet. Do not include https://.
DOMAIN=inventory.example.com
ACME_EMAIL=admin@example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USER=shoes_store_app
DB_PASSWORD=replace_with_a_long_random_database_password
DB_NAME=shoes_store_db
POSTGRES_USER=shoes_store_app
POSTGRES_PASSWORD=replace_with_the_same_database_password
POSTGRES_DB=shoes_store_db

SESSION_SECRET=replace_with_at_least_32_random_bytes
API_AUTH_REQUIRED=true
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token
TELEGRAM_BOT_USERNAME=replace_with_your_bot_username
TELEGRAM_POLL_TIMEOUT_SECONDS=25

DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Default Store
DEFAULT_OWNER_PHONE=+998000000001
DEFAULT_BRAND_NAME=Unbranded

BACKGROUND_REMOVAL_TIMEOUT_MS=120000
REMBG_MODEL=u2net
