NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USER=shoes_store_app
DB_PASSWORD=change_me_for_production
DB_NAME=shoes_store_db
POSTGRES_USER=shoes_store_app
POSTGRES_PASSWORD=change_me_for_production
POSTGRES_DB=shoes_store_db

SESSION_SECRET=replace_with_a_long_random_value
PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=http://localhost:3001/inventory
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_POLL_TIMEOUT_SECONDS=25

API_AUTH_REQUIRED=true
DEFAULT_STORE_ID=1
DEFAULT_STORE_NAME=Default Store
DEFAULT_OWNER_PHONE=+998000000001
DEFAULT_BRAND_NAME=Unbranded

# Background removal is wired to the image-processor service by docker-compose.yml.
BACKGROUND_REMOVAL_TIMEOUT_MS=120000
