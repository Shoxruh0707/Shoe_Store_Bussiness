{
	email {$ACME_EMAIL}
}

{$CADDY_DOMAINS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /uploads/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:3001
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
